# Puerto en el host donde escucha el contenedor frontend (127.0.0.1:PUERTO).
# Cada instancia de este repo en el mismo VPS (cdemo, cafeteriamana, etc.)
# necesita un puerto distinto — revisar `ss -tlnp` en el VPS antes de elegir uno.
FRONTEND_PORT=8081

DB_NAME=restaurante_db
DB_USER=app
DB_PASS=cambia_esta_password
DB_ROOT_PASS=cambia_esta_password_root

JWT_SECRET=cambia_este_secreto_en_produccion
JWT_REFRESH_SECRET=cambia_este_refresh_secreto
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https://cdemo.codewave.com.bo
# Dominio de ESTA instancia, sin barra final. El backend lo usa para armar la
# URL completa de las imágenes subidas (logos, fotos de producto) — si queda
# con el default de otra instancia, las imágenes se ven rotas porque apuntan
# al dominio equivocado.
PUBLIC_API_URL=https://cdemo.codewave.com.bo
ADMIN_PASSWORD=cambia_esta_contrasena_en_produccion

CODEPAY_SANDBOX=true
CODEPAY_API_URL=https://payapi.codewave.com.bo/api
CODEPAY_PUBLIC_KEY=
CODEPAY_SECRET_KEY=
CODEPAY_NOTIFICATION_SECRET=
CODEPAY_SANDBOX_PUBLIC_KEY=
CODEPAY_SANDBOX_SECRET_KEY=

VITE_API_URL=https://cdemo.codewave.com.bo/api/v1
